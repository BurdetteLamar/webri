#!/usr/bin/env ruby

# A console application to display Ruby HTML documentation.

require 'optparse'
require_relative '../lib/webri/version'
require_relative '../lib/webri'
require_relative '../lib/scraper'

NAME = <<EOT

Name:

There are four types of #{WebRI.variable('name')}, as determined by prefixes:

|------------------|----------------|--------------------|
|       Type       |   Starts With  |      Example       |
|------------------|----------------|--------------------|
| Class/module     | Capital letter | #{WebRI.string('Array')}            |
| Singleton method | #{WebRI.string('::')}           | #{WebRI.string('::new')}            |
| Instance method  | #{WebRI.string('#')}            | #{WebRI.string('#inspect')}         |
| Ruby file        | #{WebRI.string('ruby:')}        | #{WebRI.string('ruby:syntax_rdoc')} |
|------------------|----------------|--------------------|

Note: Singleton method prefix should be escaped as #{WebRI.string('\\#')} if your shell requires it.

Name handling:

- If #{WebRI.variable('name')} is exactly a name of its type (but not the beginning of other such names),
  #{WebRI.webri} opens the page for that name; example #{WebRI.string('Array')}.
- If #{WebRI.variable('name')} is the beginning of exactly one name of its type,
  #{WebRI.webri} asks whether to open the page for that name; example #{WebRI.string('ARG')}.
- If #{WebRI.variable('name')} is the beginning of multiple names of its type,
  #{WebRI.webri} displays those names and lets you choose; example #{WebRI.string('Pro')}.
- If #{WebRI.variable('name')} is not a valid name of its type,
  #{WebRI.webri} asks whether show such names; example #{WebRI.string('Xyzzy')}.
- If #{WebRI.variable('name')} is not valid at all (i.e., does not start with any of the prefixes above),
  #{WebRI.webri} prints an error message; example #{WebRI.string('nosuch')}.

EOT
options = {}

parser = OptionParser.new

parser.version = WebRI::VERSION
parser.banner = <<-BANNER
#{WebRI.webri} is a console application for displaying Ruby online HTML documentation.
Documentation pages are opened in the default web browser.

Usage: #{WebRI.webri} [options] #{WebRI.variable('name')}

BANNER

RELEASES = Scraper.scrapers.keys.inspect

parser.separator("Options:")
release_description = <<-EOT

EOT
parser.on('-r', '--release RELEASE',
          "Specify documentation release (one of #{RELEASES}).") do |value|
  options[:release_name] = value
end
parser.on('-i', '--info', "Print information about #{WebRI.webri}.") do
  options[:info] = true
end
parser.on('--noreline', 'Do not use Reline (useful for testing).') do |value|
  options[:noreline] = true
end
parser.on('-n', '--noop', 'Do not actually open web pages.') do |value|
  options[:noop] = true
end
parser.on('-h', '--help', 'Print this help.') do
  puts parser
  exit
end
parser.on('-v', '--version', "Print the version of #{WebRI.webri}.") do
  puts WebRI::VERSION
  exit
end
parser.separator(NAME)

parser.parse!

name = ARGV[0]
WebRI.new(name, options)
